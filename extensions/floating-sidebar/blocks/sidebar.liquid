<script>window.FSN_APP_URL = "{{ shop.url }}/apps/sidebar";</script>

<div id="fsn-root" data-shop="{{ shop.permanent_domain }}"></div>

<link rel="stylesheet" href="{{ 'sidebar.css' | asset_url }}" />
<script src="{{ 'sidebar.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Floating Side Navigation",
  "target": "body",
  "stylesheet": "sidebar.css",
  "javascript": "sidebar.js",
  "settings": [
    {
      "type": "paragraph",
      "content": "Collections and sidebar style are managed from your Shopify admin app."
    }
  ]
}
{% endschema %}
