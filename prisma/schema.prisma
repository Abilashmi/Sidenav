// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String    @db.VarChar(255)
  state         String    @db.VarChar(255)
  isOnline      Boolean   @default(false)
  scope         String?   @db.Text
  expires       DateTime?
  accessToken   String    @db.Text
  userId        BigInt?
  firstName     String?   @db.VarChar(255)
  lastName      String?   @db.VarChar(255)
  email         String?   @db.VarChar(255)
  accountOwner  Boolean   @default(false)
  locale        String?   @db.VarChar(50)
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model Shop {
  id             String                     @id @default(cuid())
  shop           String                     @unique
  accessToken    String
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  settings       SidebarSettings?
  collections    SelectedCollection[]
  products       SidebarProduct[]
  mappings       CollectionMapping[]
  schedules      NavigationSchedule[]
  deviceSettings DeviceNavigationSettings[]
  navigationMode NavigationMode?
}

model SidebarSettings {
  id              String   @id @default(cuid())
  shopId          String   @unique
  shop            Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  enabled         Boolean  @default(true)
  position        String   @default("left")
  mobileOnly      Boolean  @default(false)
  backgroundColor String   @default("#ffffff")
  textColor       String   @default("#1a1a1a")
  accentColor     String   @default("#1a1a1a")
  hoverColor      String   @default("#f1f2f3")
  badgeColor      String   @default("#e53e3e")
  borderRadius    Int      @default(12)
  shadow          Boolean  @default(true)
  iconSize        Int      @default(56)
  animationStyle  String   @default("slide")
  opacity         Float    @default(1.0)
  zIndex          Int      @default(9999)
  // Phase 2
  sidebarMode     String   @default("hamburger")
  sidebarWidth    Int      @default(280)
  topMargin       Int      @default(20)
  bottomMargin    Int      @default(20)
  // Page visibility
  pageVisibilityMode  String  @default("all")
  showOnHome          Boolean @default(true)
  showOnCollection    Boolean @default(true)
  showOnProduct       Boolean @default(true)
  showOnBlog          Boolean @default(false)
  showOnArticle       Boolean @default(false)
  showOnCart          Boolean @default(false)
  showOnSearch        Boolean @default(false)
  showOnOtherPages    Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SelectedCollection {
  id           String   @id @default(cuid())
  shopId       String
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  collectionId String
  title        String
  image        String?
  handle       String
  sortOrder    Int      @default(0)
  enabled      Boolean  @default(true)
  // Phase 2
  customImage        String?  @db.Text
  imageType          String   @default("image")
  customLabel        String?
  // Phase 3: nested collections
  parentCollectionId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([shopId, collectionId])
  @@index([shopId, sortOrder])
  @@index([shopId, parentCollectionId])
}

model SidebarProduct {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId String
  title     String
  image     String?  @db.Text
  handle    String
  price       String?
  badge       String?
  customLabel String?
  customImage String?  @db.Text
  sortOrder   Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, productId])
  @@index([shopId, sortOrder])
}

model CollectionMapping {
  id                  String   @id @default(cuid())
  shopId              String
  shop                Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  parentCollectionId  String
  parentHandle        String
  parentTitle         String
  relatedCollectionId String
  relatedHandle       String
  relatedTitle        String
  relatedImage        String?
  customImage         String?  @db.Text
  customLabel         String?
  position            Int      @default(0)
  enabled             Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([shopId, parentCollectionId, relatedCollectionId])
  @@index([shopId, parentCollectionId])
}

// Phase 3 — Feature 1: Schedule Navigation Visibility
model NavigationSchedule {
  id        String   @id @default(cuid())
  shopId    String   @map("shop_id")
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name      String
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  timezone  String   @default("UTC")
  collectionIds String? @db.LongText @map("collection_ids")
  productIds    String? @db.LongText @map("product_ids")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt    @map("updated_at")

  @@map("navigation_schedule")
  @@index([shopId])
}

// Phase 3 — Feature 2: Device-Based Navigation
model DeviceNavigationSettings {
  id           String   @id @default(cuid())
  shopId       String   @map("shop_id")
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  deviceType   String   @map("device_type")
  settingsJson String   @db.LongText @map("settings_json")
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt     @map("updated_at")

  @@map("device_navigation_settings")
  @@unique([shopId, deviceType])
}

// Phase 3 — Feature 3: Manual + Automatic Mode
model NavigationMode {
  id              String   @id @default(cuid())
  shopId          String   @unique @map("shop_id")
  shop            Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  mode            String   @default("manual")
  settingsJson    String   @db.LongText @map("settings_json")
  // Shopify Storefront API token for live collection fetching in automatic mode
  storefrontToken String?  @map("storefront_token")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt     @map("updated_at")

  @@map("navigation_mode")
}

// Phase 3 — Feature 4: Theme Conflict Protection settings
model ThemeSettings {
  id               String   @id @default(cuid())
  shop             String   @unique
  headerHeight     Int      @default(0)    @map("header_height")
  sidebarZIndex    Int      @default(9999) @map("sidebar_z_index")
  mobileBreakpoint Int      @default(768)  @map("mobile_breakpoint")
  customCss        String?  @db.LongText   @map("custom_css")
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt      @map("updated_at")

  @@map("theme_settings")
}
